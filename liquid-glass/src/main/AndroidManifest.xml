<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 11+ package visibility: lets the skin app find Poweramp -->
    <queries>
        <package android:name="com.maxmpz.audioplayer"/>
        <intent>
            <action android:name="com.maxmpz.audioplayer.API_COMMAND"/>
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name">

        <meta-data
            android:name="com.maxmpz.PowerampSkins"
            android:resource="@xml/skins"/>

        <activity
            android:name=".SkinInfoActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <intent-filter>
                <action android:name="com.maxmpz.audioplayer.SKIN_MAIN"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
