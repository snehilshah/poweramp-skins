<?xml version="1.0" encoding="utf-8"?>
<!-- Glass bar: navbar (and the menu it expands into), search, selection and volume panels. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Frosted body + hairline edge that separates it from what's behind -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="?com.maxmpz.audioplayer:corners_navbar"/>
            <solid android:color="?LiquidGlass_fill"/>
            <stroke android:width="1dp" android:color="?LiquidGlass_edge"/>
        </shape>
    </item>
    <!-- Light catching the top half -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="?com.maxmpz.audioplayer:corners_navbar"/>
            <gradient android:angle="270" android:startColor="?LiquidGlass_sheen"
                android:centerColor="#00FFFFFF" android:endColor="#00FFFFFF" android:centerY="0.5"/>
        </shape>
    </item>
    <!-- Inner rim: the bright glass edge -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="?com.maxmpz.audioplayer:corners_navbar"/>
            <stroke android:width="1dp" android:color="?LiquidGlass_rim"/>
        </shape>
    </item>
</layer-list>
