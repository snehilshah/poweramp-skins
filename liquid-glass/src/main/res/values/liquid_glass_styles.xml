        <item name="com.maxmpz.audioplayer:colorBgLight">#2C2C2E</item>
        <item name="com.maxmpz.audioplayer:colorBgCheckedLight">#3A3A3C</item>
        <!-- No shadow: invisible on black, and it would muddy the translucent glass -->
        <item name="com.maxmpz.audioplayer:navbar_elevation">0dp</item>

        <!-- Play/pause, prev/next: frosted graphite disc with a light rim, white icon -->
        <item name="com.maxmpz.audioplayer:colorPlayButtonsBg">#E62C2C2E</item>
        <item name="com.maxmpz.audioplayer:colorPlayButtonsStroke">#59FFFFFF</item>
        <item name="com.maxmpz.audioplayer:colorPlayButtonsTint">#FFFFFF</item>

        <!-- Same in LiquidGlass: keep in sync -->
        <item name="com.maxmpz.audioplayer:corners_navbar">28dp</item>
        <item name="com.maxmpz.audioplayer:corners_popup">20dp</item>
        <item name="com.maxmpz.audioplayer:corners_medium">14dp</item>
        <item name="com.maxmpz.audioplayer:corners_medium_plus">16dp</item>
        <item name="com.maxmpz.audioplayer:corners_searchbar">28dp</item>
