<resources xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="ResourceCycle, NewApi">

    <!--
    Liquid Glass: frosted glass on the controls and navigation that float over content
    (navbar and the menu it expands into, panels, floating buttons, play button). Content stays calm.

    Each skin derives from Poweramp's own light/dark theme, so every Poweramp color (popups, chips, lists, dialogs)
    matches the mode and text keeps its contrast. The glass is drawn by drawable/lg_*.xml from the colors below:
      LiquidGlass_fill_*   body of the glass per variant (Regular / Clear / Reduce Transparency)
      LiquidGlass_sheen    light catching the top half
      LiquidGlass_rim      bright inner edge
      LiquidGlass_edge     hairline separating the glass from what's behind
    Keep fills at ~65% opacity or more: text and icons sit on them and must stay readable over any album art.
    -->

    <!-- ===== Light ===== -->
    <style name="LiquidGlass" parent="com.maxmpz.audioplayer:style/ActivityTheme_White">
        <item name="LiquidGlass_fill_regular">#DBF9F9FB</item>
        <item name="LiquidGlass_fill_clear">#ADF9F9FB</item>
        <item name="LiquidGlass_fill_opaque">#FFF9F9FB</item>
        <item name="LiquidGlass_fill">?LiquidGlass_fill_regular</item>
        <item name="LiquidGlass_sheen">#B3FFFFFF</item>
        <item name="LiquidGlass_rim">#CCFFFFFF</item>
        <item name="LiquidGlass_edge">#1F000000</item>
        <item name="LiquidGlass_ripple">#1F000000</item>
        <item name="LiquidGlass_label">#8C000000</item>

        <item name="com.maxmpz.audioplayer:colorBgPrimary">#F2F2F7</item>
        <item name="com.maxmpz.audioplayer:colorBgNavbar">#F9F9FB</item>
        <item name="com.maxmpz.audioplayer:colorBgTransparentNavbar">?LiquidGlass_fill</item>
        <item name="com.maxmpz.audioplayer:navbar_elevation">2dp</item>

        <!-- Play/pause, prev/next: frosted white disc, dark icon -->
        <item name="com.maxmpz.audioplayer:colorPlayButtonsBg">#EBFFFFFF</item>
        <item name="com.maxmpz.audioplayer:colorPlayButtonsStroke">#33000000</item>
        <item name="com.maxmpz.audioplayer:colorPlayButtonsTint">#000000</item>

        <!-- Same in LiquidGlassDark: keep in sync -->
        <item name="com.maxmpz.audioplayer:corners_navbar">28dp</item>
        <item name="com.maxmpz.audioplayer:corners_popup">20dp</item>
        <item name="com.maxmpz.audioplayer:corners_medium">14dp</item>
        <item name="com.maxmpz.audioplayer:corners_medium_plus">16dp</item>
        <item name="com.maxmpz.audioplayer:corners_searchbar">28dp</item>
        <item name="com.maxmpz.audioplayer:corners_mini">10dp</item>
        <item name="com.maxmpz.audioplayer:corners_large">24dp</item>
        <item name="com.maxmpz.audioplayer:corners_small">8dp</item>
        <item name="com.maxmpz.audioplayer:corners_aa_tracks">12dp</item>
        <item name="com.maxmpz.audioplayer:corners_aa_albums">12dp</item>
        <item name="com.maxmpz.audioplayer:corners_aa_other">matchHeight</item>
        <item name="com.maxmpz.audioplayer:corners_aa_tracks_zoomed">12dp</item>
        <item name="com.maxmpz.audioplayer:corners_aa_albums_zoomed">12dp</item>
        <item name="com.maxmpz.audioplayer:corners_aa_other_zoomed">matchHeight</item>
        <item name="com.maxmpz.audioplayer:corners_aa_tracks_grid">16dp</item>
        <item name="com.maxmpz.audioplayer:corners_aa_albums_grid">16dp</item>
        <item name="com.maxmpz.audioplayer:corners_aa_other_grid">matchHeight</item>
        <item name="com.maxmpz.audioplayer:corners_aa_tracks_grid_zoomed">16dp</item>
        <item name="com.maxmpz.audioplayer:corners_aa_albums_grid_zoomed">16dp</item>
        <item name="com.maxmpz.audioplayer:corners_aa_other_grid_zoomed">matchHeight</item>
        <item name="com.maxmpz.audioplayer:corners_aa_tracks_small">8dp</item>
        <item name="com.maxmpz.audioplayer:corners_aa_scene_aa">28dp</item>
        <item name="com.maxmpz.audioplayer:corners_miniplayer_aa">12dp</item>
        <item name="com.maxmpz.audioplayer:Navbar">@style/LiquidGlass_Navbar</item>
        <item name="com.maxmpz.audioplayer:Navbar_scene_navbar_1line_sheet">@style/LiquidGlass_Navbar_scene_navbar_1line_sheet</item>
        <item name="com.maxmpz.audioplayer:Navbar_scene_navbar_2lines">@style/LiquidGlass_Navbar_scene_navbar_2lines</item>
        <item name="com.maxmpz.audioplayer:SelectionMenuSubcontainer">@style/LiquidGlass_SelectionMenuSubcontainer</item>
        <item name="com.maxmpz.audioplayer:SelectionMenuSubcontainer_scene_selection_menu">@style/LiquidGlass_SelectionMenuSubcontainer_scene_selection_menu</item>
        <item name="com.maxmpz.audioplayer:TopActionModeBar">@style/LiquidGlass_TopActionModeBar</item>
        <item name="com.maxmpz.audioplayer:TopSearchPanel">@style/LiquidGlass_TopSearchPanel</item>
        <item name="com.maxmpz.audioplayer:VolumePanelFrame">@style/LiquidGlass_VolumePanelFrame</item>
        <item name="com.maxmpz.audioplayer:ItemHeaderShuffleButton">@style/LiquidGlass_ItemHeaderShuffleButton</item>
        <item name="com.maxmpz.audioplayer:ItemHeaderPlayButton">@style/LiquidGlass_ItemHeaderPlayButton</item>
        <item name="com.maxmpz.audioplayer:ItemHeaderSelectButton">@style/LiquidGlass_ItemHeaderSelectButton</item>
        <item name="com.maxmpz.audioplayer:ItemHeaderSearchButton">@style/LiquidGlass_ItemHeaderSearchButton</item>
        <item name="com.maxmpz.audioplayer:ItemTrackMenu_scene_header">@style/LiquidGlass_ItemTrackMenu_scene_header</item>
        <item name="com.maxmpz.audioplayer:ItemTrackMenu_scene_bottom_toolbar">@style/LiquidGlass_ItemTrackMenu_scene_bottom_toolbar</item>
        <item name="com.maxmpz.audioplayer:ItemTextMenu_scene_bottom_toolbar">@style/LiquidGlass_ItemTrackMenu_scene_bottom_toolbar</item>
        <item name="com.maxmpz.audioplayer:TopMetaInfo">@style/LiquidGlass_TopMetaInfo</item>
        <item name="com.maxmpz.audioplayer:TopMetaInfoLabel">@style/LiquidGlass_TopMetaInfoLabel</item>
    </style>

    <!-- ===== Dark ===== -->
    <style name="LiquidGlassDark" parent="com.maxmpz.audioplayer:style/ActivityTheme_Black">
        <item name="LiquidGlass_fill_regular">#D91C1C1E</item>
        <item name="LiquidGlass_fill_clear">#A61C1C1E</item>
        <item name="LiquidGlass_fill_opaque">#FF1C1C1E</item>
        <item name="LiquidGlass_fill">?LiquidGlass_fill_regular</item>
        <item name="LiquidGlass_sheen">#24FFFFFF</item>
        <item name="LiquidGlass_rim">#1FFFFFFF</item>
        <item name="LiquidGlass_edge">#33FFFFFF</item>
        <item name="LiquidGlass_ripple">#33FFFFFF</item>
        <item name="LiquidGlass_label">#8C000000</item>

        <item name="com.maxmpz.audioplayer:colorBgPrimary">#1C1C1E</item>
