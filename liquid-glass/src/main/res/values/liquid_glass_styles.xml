    <!-- ===== Glass surfaces ===== -->
    <style name="LiquidGlass_Navbar" parent="com.maxmpz.audioplayer:Navbar">
        <item name="android:background">@drawable/lg_bar</item>
        <item name="com.maxmpz.audioplayer:applyViewParams">true</item>
    </style>
    <!-- The navbar expands into these for the main menu: same glass, so the menu stays readable -->
    <style name="LiquidGlass_Navbar_scene_navbar_1line_sheet" parent="com.maxmpz.audioplayer:Navbar_scene_navbar_1line_sheet">
        <item name="android:background">@drawable/lg_bar</item>
        <item name="com.maxmpz.audioplayer:applyViewParams">true</item>
    </style>
    <style name="LiquidGlass_Navbar_scene_navbar_2lines" parent="com.maxmpz.audioplayer:Navbar_scene_navbar_2lines">
        <item name="android:background">@drawable/lg_bar</item>
        <item name="com.maxmpz.audioplayer:applyViewParams">true</item>
    </style>
    <style name="LiquidGlass_SelectionMenuSubcontainer" parent="com.maxmpz.audioplayer:SelectionMenuSubcontainer">
        <item name="android:background">@drawable/lg_bar</item>
    </style>
    <style name="LiquidGlass_SelectionMenuSubcontainer_scene_selection_menu" parent="com.maxmpz.audioplayer:SelectionMenuSubcontainer_scene_selection_menu">
        <item name="android:background">@drawable/lg_bar</item>
        <item name="com.maxmpz.audioplayer:applyViewParams">true</item>
    </style>
    <style name="LiquidGlass_TopActionModeBar" parent="com.maxmpz.audioplayer:TopActionModeBar">
        <item name="android:background">@drawable/lg_bar</item>
    </style>
    <style name="LiquidGlass_TopSearchPanel" parent="com.maxmpz.audioplayer:TopSearchPanel">
        <item name="android:background">@drawable/lg_bar</item>
    </style>
    <style name="LiquidGlass_VolumePanelFrame" parent="com.maxmpz.audioplayer:VolumePanelFrame">
        <item name="android:background">@drawable/lg_bar</item>
    </style>

    <!-- Floating buttons over cover art -->
    <style name="LiquidGlass_ItemHeaderShuffleButton" parent="com.maxmpz.audioplayer:ItemHeaderShuffleButton">
        <item name="android:background">@drawable/lg_button</item>
    </style>
    <style name="LiquidGlass_ItemHeaderPlayButton" parent="com.maxmpz.audioplayer:ItemHeaderPlayButton">
        <item name="android:background">@drawable/lg_button</item>
    </style>
    <style name="LiquidGlass_ItemHeaderSelectButton" parent="com.maxmpz.audioplayer:ItemHeaderSelectButton">
        <item name="android:background">@drawable/lg_button</item>
    </style>
    <style name="LiquidGlass_ItemHeaderSearchButton" parent="com.maxmpz.audioplayer:ItemHeaderSearchButton">
        <item name="android:background">@drawable/lg_button</item>
    </style>
    <style name="LiquidGlass_ItemTrackMenu_scene_header" parent="com.maxmpz.audioplayer:ItemTrackMenu_scene_header">
        <item name="android:background">@drawable/lg_button</item>
        <item name="com.maxmpz.audioplayer:applyViewParams">true</item>
    </style>
    <style name="LiquidGlass_ItemTrackMenu_scene_bottom_toolbar" parent="com.maxmpz.audioplayer:ItemTrackMenu_scene_bottom_toolbar">
        <item name="android:background">@drawable/lg_button</item>
        <item name="com.maxmpz.audioplayer:applyViewParams">true</item>
    </style>

    <!-- Title/artist over album art: dark glass label keeps white text readable on any cover -->
    <style name="LiquidGlass_TopMetaInfo" parent="com.maxmpz.audioplayer:TopMetaInfo">
        <item name="com.maxmpz.audioplayer:lineBackground">@drawable/lg_label</item>
    </style>
    <style name="LiquidGlass_TopMetaInfoLabel" parent="com.maxmpz.audioplayer:TopMetaInfoLabel">
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <!-- ===== Skin options (applied on top of the light/dark theme) ===== -->
    <!-- Dark skin only: cool blue-grey glass and a blue seek bar instead of neutral graphite -->
    <style name="LiquidGlassDark_Midnight">
        <item name="LiquidGlass_fill_regular">#D91A2231</item>
        <item name="LiquidGlass_fill_clear">#A61A2231</item>
        <item name="LiquidGlass_fill_opaque">#FF1A2231</item>

        <item name="com.maxmpz.audioplayer:colorBgPrimary">#101116</item>
        <item name="com.maxmpz.audioplayer:colorBgNavbar">#1A2231</item>
        <item name="com.maxmpz.audioplayer:colorBgLight">#1B1E26</item>
        <item name="com.maxmpz.audioplayer:colorBgCheckedLight">#252A35</item>
        <item name="com.maxmpz.audioplayer:colorPlayButtonsBg">#E6252A35</item>

        <item name="com.maxmpz.audioplayer:colorWaveseekTint">#8EAEFF</item>
        <item name="com.maxmpz.audioplayer:colorSeekbarBg">#3DFFFFFF</item>
        <item name="com.maxmpz.audioplayer:colorSeekbarProgress">#8EAEFF</item>
        <item name="com.maxmpz.audioplayer:colorSeekbarThumb">#B6CAFF</item>
    </style>
    <style name="LiquidGlass_Clear">
        <item name="LiquidGlass_fill">?LiquidGlass_fill_clear</item>
    </style>
    <style name="LiquidGlass_ReduceTransparency">
        <item name="LiquidGlass_fill">?LiquidGlass_fill_opaque</item>
        <item name="com.maxmpz.audioplayer:colorPlayButtonsBg">?LiquidGlass_fill_opaque</item>
    </style>
</resources>
